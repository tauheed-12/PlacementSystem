{
  "Routes": [
    // Auth Service Configuration
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "authservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/auth/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // Placement Drive Service Configuration
    {
      "DownstreamPathTemplate": "/api/drives/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "placementdriveservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/drives/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // Student Service Configuration
    {
      "DownstreamPathTemplate": "/api/student/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "studentservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/student/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // Notification Service - preferences
    {
      "DownstreamPathTemplate": "/api/notification/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "notificationservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/notification/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },
    // Notification Service - notifications list
    {
      "DownstreamPathTemplate": "/api/notifications",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "notificationservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/notifications",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/notifications/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "notificationservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/notifications/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    },

    // Application Service Configuration
    {
      "DownstreamPathTemplate": "/api/application/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "applicationservice",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/application/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://apigateway:8080",
    "RateLimitOptions": {
      "ClientIdHeader": "X-Client-Id",
      "EnableRateLimiting": true,
      "Period": "1m",
      "Limit": 100
    }
  }
}
